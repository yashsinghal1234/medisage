PORT=5000
MONGODB_URI=mongodb://localhost:27017/medisage
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_random_hex
# Encrypt uploaded clinical files at rest (AES-256-GCM). 64 hex chars:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=replace_with_strong_random_hex_key
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d
OPENAI_API_KEY=your_openai_api_key_here
NODE_ENV=development
# CORS — comma-separated allowed origins (frontend dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Google OAuth — required for Google Sign-In. Use the SAME Client ID
# as VITE_GOOGLE_CLIENT_ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# First-admin bootstrap — required pair in production (seeded only while no admin exists)
ADMIN_SEED_EMAIL=your_admin_email_here
ADMIN_SEED_PASSWORD=your_admin_strong_password_here
# Password-reset email delivery (unset in dev: reset tokens print to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediSage <no-reply@medisage.health>
APP_PUBLIC_URL=
# Dev/test-only limiter off-switch (ignored in production; leave false)
RATE_LIMITS_DISABLED=false
