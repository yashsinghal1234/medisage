{
  "name": "medisage",
  "version": "2.0.0",
  "description": "MediSage — Clinical Document Management & AI Health Intelligence",
  "main": "server/server.js",
  "scripts": {
    "install-all": "npm install && cd client && npm install",
    "server": "node server/server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "medical",
    "healthtech",
    "document-vault",
    "ai",
    "clinical-records",
    "ease-health"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.4",
    "multer": "^1.4.5-lts.1"
  }
}
