{
  "name": "medisage",
  "version": "2.0.0",
  "description": "MediSage — Clinical Document Management & AI Health Intelligence",
  "main": "server/server.js",
  "scripts": {
    "install-all": "npm install && cd client && npm install",
    "server": "node server/server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": ["medical", "healthtech", "document-vault", "ai", "clinical-records", "ease-health"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.8.4",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "concurrently": "^8.2.1",
    "axios": "^1.7.9"
  }
}
